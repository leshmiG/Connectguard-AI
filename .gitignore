# Environment / secrets
.env
*.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Runtime data (don't commit real passenger/flight data or logs)
data/*.db
logs/*.jsonl
traces/*.jsonl

# Keep the folders themselves tracked
!data/.gitkeep
!logs/.gitkeep
!traces/.gitkeep

# OS/editor cruft
.DS_Store
.vscode/
.idea/
